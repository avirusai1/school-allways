# =============================================================================
# School All Ways — environment template
# Copy to .env and fill in. NEVER commit .env.
# =============================================================================

NODE_ENV=development
TZ=Asia/Kolkata

# --- Public URLs -------------------------------------------------------------
APP_BASE_URL=https://school.techallways.com
API_BASE_URL=https://api.school.techallways.com
FILES_BASE_URL=https://files.school.techallways.com
ADMIN_WEB_URL=https://admin.school.techallways.com
FAMILY_WEB_URL=https://app.school.techallways.com
# Our own console. Must be listed or CORS blocks every call it makes.
CONTROL_WEB_URL=https://control.school.techallways.com

# --- Platform console bootstrap ----------------------------------------------
# Creates a login for apps/web-control. Read by `pnpm db:seed`; leave unset and
# the seed skips it, which is what CI and a fresh clone want.
#
# LOCAL AND STAGING ONLY. This account can see every school on the platform.
# Do not set these in production — provisioning that account is a separate
# conversation involving key rotation and more than one person.
PLATFORM_ADMIN_EMAIL=
PLATFORM_ADMIN_PASSWORD=
PLATFORM_ADMIN_NAME=

# --- Database ----------------------------------------------------------------
POSTGRES_USER=saw_owner
POSTGRES_PASSWORD=
POSTGRES_DB=school_all_ways

# Migrations run as the OWNER role.
DATABASE_URL=postgres://saw_owner:PASSWORD@localhost:5432/school_all_ways
# The API connects as the RESTRICTED role. This is what enforces RLS.
# If these two are ever the same value, tenant isolation is OFF. Check it.
DATABASE_APP_URL=postgres://saw_app:PASSWORD@localhost:5432/school_all_ways
DATABASE_READONLY_URL=postgres://saw_readonly:PASSWORD@localhost:5432/school_all_ways

# --- Redis -------------------------------------------------------------------
REDIS_PASSWORD=
REDIS_URL=redis://:PASSWORD@localhost:6379

# --- Auth --------------------------------------------------------------------
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5

# --- Storage (block volume, per your decision) -------------------------------
# Abstracted behind StorageService so this can become R2/S3 later without a
# code change. See docs/04.
STORAGE_DRIVER=local
STORAGE_LOCAL_ROOT=/data/storage
STORAGE_SIGNED_URL_TTL_SECONDS=900
STORAGE_MAX_UPLOAD_MB=100

# When you outgrow the block volume, switch to:
# STORAGE_DRIVER=s3
# S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# S3_BUCKET=school-all-ways
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_REGION=auto

# --- SMS (DLT-registered templates required in India) ------------------------
SMS_PROVIDER=msg91
MSG91_AUTH_KEY=
MSG91_SENDER_ID=
DLT_ENTITY_ID=

# --- WhatsApp (P1) -----------------------------------------------------------
WHATSAPP_PROVIDER=
WHATSAPP_API_KEY=

# --- Push — see docs/push-setup.md ------------------------------------------
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=

# --- Payments ----------------------------------------------------------------
PAYMENT_GATEWAY=razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- B2B tax invoices (manual activations + Stay Connected Fee) --------------
# Invoice generation fails loudly if FIRM_GSTIN is unset. Do not ship a blank GSTIN.
FIRM_NAME=
FIRM_GSTIN=
FIRM_ADDRESS=
FIRM_STATE_CODE=

# --- Email -------------------------------------------------------------------
# Gmail SMTP for invite + notification email. Use an App Password
# (Google Account → Security → 2-Step Verification → App passwords), not the
# account password. Fine for pilot schools (~500/day consumer, ~2000/day
# Workspace). Move to SES/Postmark before any school with thousands of parents
# shares the same mailbox — don't raise the Gmail ceiling.
GMAIL_USER=
GMAIL_APP_PASSWORD=

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=noreply@techallways.com

# --- Observability -----------------------------------------------------------
SENTRY_DSN=
LOG_LEVEL=info

# --- Backups -----------------------------------------------------------------
BACKUP_RETENTION_DAYS=14
BACKUP_INTERVAL_SECONDS=86400
# rclone remote for OFF-BOX copies. Leave empty at your own risk — see
# infra/scripts/backup-loop.sh for why this matters with local file storage.
BACKUP_REMOTE=

# --- Cost controls -----------------------------------------------------------
# SMS is the sneaky variable cost. Push first; escalate only for high/critical
# messages that stay unread past this window.
SMS_ESCALATION_MINUTES=45
SMS_DAILY_CAP_PER_TENANT=2000
COMMS_QUIET_HOURS_START=21:00
COMMS_QUIET_HOURS_END=07:00
