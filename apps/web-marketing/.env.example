# The marketing site is a static export (`output: 'export'`), so these are
# inlined at build time, not read at runtime. Changing them means rebuilding.
#
# The defaults in src/lib/api.ts and the signup form match local dev, so this
# file only needs filling in for staging and production.

# Where the signup form posts. Must include the /v1 prefix.
NEXT_PUBLIC_API_BASE_URL=https://api.school.techallways.com/v1

# Where a verified signup is handed over to, and where "Sign in instead" points.
# Must match the API's own ADMIN_WEB_URL, which builds the handoff redirect.
NEXT_PUBLIC_ADMIN_WEB_URL=https://admin.school.techallways.com
