node_modules/
.pnpm-store/

# Build output
dist/
build/
.next/
out/
.turbo/
*.tsbuildinfo

# Environment — NEVER commit
.env
.env.*
!.env.example

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# OS
.DS_Store
Thumbs.db

# Editors
.vscode/*
!.vscode/extensions.json
.idea/

# Flutter / Dart
**/.dart_tool/
**/.flutter-plugins
**/.flutter-plugins-dependencies
**/.packages
**/build/
**/android/.gradle/
**/android/local.properties
**/android/key.properties
**/android/app/google-services.json
**/ios/Pods/
**/ios/.symlinks/
*.jks
*.keystore
!debug.keystore
**/upload-keystore.jks

# Local data / storage (block-volume mount is NOT in the repo).
#
# These MUST stay anchored. An unanchored `storage/` also matches
# apps/api/src/common/storage/ — which is source code, not data — and
# silently kept it out of the first commit. CI caught it as:
#   Cannot find module '../../common/storage/storage.service'
# Anchor any new rule here the same way, or check `git check-ignore -v <path>`
# before trusting it.
/storage/
/uploads/
/backups/
/pgdata/
apps/api/storage/
apps/api/uploads/

# Test / coverage
coverage/
.nyc_output/

# Drizzle
db/migrations/meta/_journal.json.bak

# The repo-root /build directory is product SPECS (00-…16-…md), not build
# output. The `build/` and `**/build/` rules above are for Flutter/Node
# artefacts and would otherwise silently exclude every spec in the project.
# These negations must stay at the end of the file — later rules win.
!/build/
!/build/*.md
HANDOFF.md

# Local Claude Code tooling (machine-specific permissions, dev-server config)
.claude/
