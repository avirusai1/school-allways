{
  "name": "school-all-ways",
  "version": "0.1.0",
  "private": true,
  "description": "School All Ways — multi-tenant school management SaaS for Indian K-12 schools",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:generate": "pnpm --filter @saw/db generate",
    "db:migrate": "pnpm --filter @saw/db migrate",
    "db:seed": "pnpm --filter @saw/db seed",
    "db:seed:demo": "pnpm --filter @saw/db seed:demo",
    "db:seed:onboarding": "pnpm --filter @saw/db seed:onboarding",
    "db:studio": "pnpm --filter @saw/db studio",
    "infra:up": "docker compose -f infra/docker-compose.yml up -d",
    "infra:local": "docker compose -f infra/docker-compose.local.yml --env-file .env up -d",
    "infra:local:down": "docker compose -f infra/docker-compose.local.yml --env-file .env down",
    "local:setup": "bash scripts/local-up.sh",
    "local:reset": "docker compose -f infra/docker-compose.local.yml --env-file .env down -v && bash scripts/local-up.sh",
    "infra:down": "docker compose -f infra/docker-compose.yml down",
    "infra:logs": "docker compose -f infra/docker-compose.yml logs -f",
    "build:web": "pnpm --filter @saw/web-admin build && pnpm --filter @saw/web-family build && pnpm --filter @saw/web-control build && pnpm --filter @saw/web-marketing build",
    "build:api": "pnpm --filter @saw/api build",
    "build:android": "bash scripts/build-android-local.sh",
    "build:android:device": "bash scripts/build-android-local.sh device"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.7.5",
    "eslint": "^10.8.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.9.0",
    "prettier": "^3.3.3",
    "turbo": "^2.1.3",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.67.0"
  },
  "pnpm": {
    "overrides": {
      "drizzle-orm": "0.36.4",
      "postgres": "3.4.4"
    }
  }
}
